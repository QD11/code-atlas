{
  "name": "@dububu/code-atlas",
  "version": "0.0.1",
  "description": "Visualize how exported-symbol changes affect a JavaScript or TypeScript project.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "code-atlas": "bin/code-atlas.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "playground": "node scripts/create-playground.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/cli/index.ts --no-open",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:node && npm run build:web",
    "build:node": "tsup src/cli/index.ts --format esm --platform node --target node22 --out-dir dist --clean --sourcemap",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fastify/static": "^10.1.2",
    "chokidar": "^4.0.3",
    "fastify": "^5.6.0",
    "open": "^10.2.0",
    "oxc-parser": "^0.143.0",
    "styled-components": "^6.5.0",
    "typescript": "^6.0.0"
  },
  "devDependencies": {
    "@cosmos.gl/graph": "^3.3.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript-eslint": "8.66.0",
    "vite": "^8.1.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QD11/code-atlas.git"
  },
  "homepage": "https://github.com/QD11/code-atlas#readme",
  "bugs": {
    "url": "https://github.com/QD11/code-atlas/issues"
  },
  "keywords": [
    "typescript",
    "javascript",
    "dependency-graph",
    "static-analysis",
    "developer-tools",
    "git"
  ]
}
